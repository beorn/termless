.{
    .name = .termless_ghostty_native,
    .version = "0.1.0",
    .fingerprint = 0x7e83b83bd6f917e6,

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },

    .dependencies = .{
        // Node-API C headers (translated via Ghostty's bundled translate_c for Zig 0.17+)
        .node_api = .{
            .url = "git+https://github.com/nodejs/node-api-headers?ref=main#d46edabd5bbacc08393578eb19fc2eba7021b597",
            .hash = "N-V-__8AAASNAQA0UI0mvQk4LyFEhdFuFBPgH8HSokdFFpnz",
        },

        // Ghostty's translate_c wrapper (Zig 0.17 removed @cImport)
        .translate_c = .{
            .path = ".ghostty-src/pkg/translate-c",
        },

        // ghostty — terminal emulation core (Zig module)
        // Uses local path to the cloned ghostty source. The build script
        // (build/build.sh) clones ghostty into .ghostty-src/ before building.
        .ghostty = .{
            .path = ".ghostty-src",
            .lazy = true,
        },
    },
}
