{
  "suite": "libvterm/12state_scroll.test",
  "name": "Linefeed in DECSTBM",
  "cols": 80,
  "rows": 25,
  "sourceLine": 27,
  "license": "MIT",
  "steps": [
    {
      "input": "\u001b[1;10r",
      "expectedCursor": {
        "row": 0,
        "col": 0
      }
    },
    {
      "input": "\n\n\n\n\n\n\n\n\n",
      "expectedCursor": {
        "row": 9,
        "col": 0
      }
    },
    {
      "input": "\n",
      "expectedCursor": {
        "row": 9,
        "col": 0
      }
    }
  ]
}
