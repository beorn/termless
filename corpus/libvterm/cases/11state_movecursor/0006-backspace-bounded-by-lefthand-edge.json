{
  "suite": "libvterm/11state_movecursor.test",
  "name": "Backspace bounded by lefthand edge",
  "cols": 80,
  "rows": 25,
  "sourceLine": 21,
  "license": "MIT",
  "steps": [
    {
      "input": "ABC\b\t\r\n\u001b[4;2H",
      "expectedCursor": {
        "row": 3,
        "col": 1
      }
    },
    {
      "input": "\b",
      "expectedCursor": {
        "row": 3,
        "col": 0
      }
    },
    {
      "input": "\b",
      "expectedCursor": {
        "row": 3,
        "col": 0
      }
    }
  ]
}
