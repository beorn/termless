++/// Borrow the engine-owned URI for an absolute buffer coordinate.
++/// The caller copies before another engine call; this lookup allocates nothing.
++pub fn renderStateGetHyperlink(
++    ptr: ?*anyopaque,
++    row: c_int,
++    col: c_int,
++    out_ptr_len: ?[*]usize,
++) callconv(.c) c_int {
++    const out = out_ptr_len orelse return -1;
++    out[0] = 0;
++    out[1] = 0;
++    const wrapper: *const TerminalWrapper = @ptrCast(@alignCast(ptr orelse return -1));
++    const t = &wrapper.terminal;
++    if (row < 0 or col < 0) return -1;
++    const y: usize = @intCast(row);
++    const x: usize = @intCast(col);
++    if (x >= t.cols) return -1;
++    const history: usize = @intCast(getScrollbackLength(ptr));
++    if (y >= history + @as(usize, t.rows)) return -1;
++    const pages = &t.screens.active.pages;
++    const pin = (if (y < history)
++        pages.pin(.{ .history = .{ .y = @intCast(y) } })
++    else
++        pages.pin(.{ .active = .{ .y = @intCast(y - history) } })) orelse return -1;
++    const cells = pin.cells(.all);
++    if (x >= cells.len) return -1;
++    const cell = &cells[x];
++    if (!cell.hyperlink) return 0;
++    const page = pin.node.data;
++    const id = page.lookupHyperlink(cell) orelse return -1;
++    const link = page.hyperlink_set.get(page.memory, id);
++    const uri = link.uri.slice(page.memory);
++    out[0] = @intFromPtr(uri.ptr);
++    out[1] = uri.len;
++    return 1;
++}
