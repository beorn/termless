{
  "name": "@termless/core",
  "version": "0.10.0",
  "description": "Headless terminal testing library — like Playwright, but for terminal apps. Cross-terminal conformance, composable selectors, 21+ Vitest matchers.",
  "keywords": [
    "ansi",
    "cross-terminal",
    "ghostty",
    "headless",
    "terminal",
    "terminal-emulator",
    "terminal-testing",
    "testing",
    "tui",
    "tui-testing",
    "vitest",
    "xterm"
  ],
  "homepage": "https://termless.dev/",
  "bugs": {
    "url": "https://github.com/beorn/termless/issues"
  },
  "license": "MIT",
  "author": "Beorn",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/termless.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "assets",
    "backends.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./io": "./src/io/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./io": {
        "types": "./dist/io/index.d.mts",
        "import": "./dist/io/index.mjs",
        "default": "./dist/io/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown && tsdown -W",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ci": "bun vitest run",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "fix": "oxfmt --write .",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check-private": "bun scripts/check-private-leak.ts",
    "cli": "bun packages/cli/src/cli.ts",
    "publish:all": "bun scripts/publish-workspaces.ts"
  },
  "devDependencies": {
    "@termless/alacritty": "workspace:*",
    "@termless/ghostty": "workspace:*",
    "@termless/kitty": "workspace:*",
    "@termless/libvterm": "workspace:*",
    "@termless/peekaboo": "workspace:*",
    "@termless/vt100": "workspace:*",
    "@termless/vt100-rust": "workspace:*",
    "@termless/vt220": "workspace:*",
    "@termless/vterm": "workspace:*",
    "@termless/wezterm": "workspace:*",
    "@termless/xtermjs": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.14",
    "@vitest/expect": "^4.1.10",
    "@vue/server-renderer": "3.5.43",
    "loggily": "^0.10.2",
    "oxfmt": "0.38.0",
    "silvery": "^0.24.0",
    "tsdown": "0.22.13",
    "typescript": "^5.9.3",
    "verify-publishable": "github:beorn/verify-publishable#8c1406b3605e7ff720b1962777f097859ce385b3",
    "vitepress": "^1.6.4",
    "vitepress-enrich": "^0.4.0",
    "vitepress-plugin-llms": "1.14.0",
    "vitest": "^4.1.10",
    "vue": "3.5.43"
  },
  "peerDependencies": {
    "@termless/ghostty": "^0.10.0",
    "node-pty": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@termless/ghostty": {
      "optional": true
    },
    "node-pty": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@resvg/resvg-js": "^2.6.2",
    "@twemoji/svg": "^15.0.0",
    "ghostty-web": "^0.4.0",
    "gifenc": "^1.0.3",
    "playwright": "^1.59.0",
    "upng-js": "^2.1.0"
  },
  "overrides": {
    "@termless/core": "link:."
  },
  "tsdown": {
    "clean": true,
    "dts": {
      "eager": true
    },
    "entry": [
      "src/index.ts",
      "src/io/index.ts"
    ],
    "format": "esm"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=23.6.0"
  },
  "verifyPublishable": {
    "maxUnpackedBytes": 8388608,
    "public": [
      "@termless/alacritty",
      "@termless/cli",
      "@termless/core",
      "@termless/ghostty",
      "@termless/ghostty-native",
      "@termless/kitty",
      "@termless/libvterm",
      "@termless/peekaboo",
      "@termless/swash-render",
      "@termless/test",
      "@termless/vt100",
      "@termless/vt100-rust",
      "@termless/vt220",
      "@termless/vterm",
      "@termless/web-player",
      "@termless/wezterm",
      "@termless/xtermjs",
      "termless"
    ],
    "checks": [
      {
        "package": "@termless/core",
        "runner": "node",
        "args": [
          "tests/packed-node-smoke.mjs"
        ],
        "files": [
          "tests/packed-node-smoke.mjs"
        ]
      },
      {
        "package": "@termless/libvterm",
        "runner": "node",
        "args": [
          "tests/packed-libvterm-node-smoke.mjs"
        ],
        "files": [
          "tests/packed-libvterm-node-smoke.mjs"
        ]
      },
      {
        "package": "@termless/ghostty-native",
        "runner": "node",
        "args": [
          "tests/packed-ghostty-native-node-smoke.mjs",
          "@termless/ghostty-native"
        ],
        "files": [
          "tests/packed-ghostty-native-node-smoke.mjs"
        ]
      },
      {
        "package": "@termless/test",
        "runner": "vitest",
        "args": [
          "run",
          "tests/packed-vitest-smoke.test.ts"
        ],
        "files": [
          "tests/packed-vitest-smoke.test.ts"
        ]
      },
      {
        "package": "@termless/alacritty",
        "runner": "node",
        "args": [
          "tests/packed-ghostty-native-node-smoke.mjs",
          "@termless/alacritty"
        ],
        "files": [
          "tests/packed-ghostty-native-node-smoke.mjs"
        ]
      },
      {
        "package": "@termless/wezterm",
        "runner": "node",
        "args": [
          "tests/packed-ghostty-native-node-smoke.mjs",
          "@termless/wezterm"
        ],
        "files": [
          "tests/packed-ghostty-native-node-smoke.mjs"
        ]
      },
      {
        "package": "@termless/vt100-rust",
        "runner": "node",
        "args": [
          "tests/packed-ghostty-native-node-smoke.mjs",
          "@termless/vt100-rust"
        ],
        "files": [
          "tests/packed-ghostty-native-node-smoke.mjs"
        ]
      },
      {
        "package": "@termless/cli",
        "runner": "node",
        "args": [
          "tests/packed-cli-png-smoke.mjs"
        ],
        "files": [
          "tests/packed-cli-png-smoke.mjs"
        ]
      }
    ],
    "build": "nix shell .#native-tools --command bash -euc 'export CARGO_BUILD_JOBS=\"${CARGO_BUILD_JOBS:-2}\"; for package in alacritty wezterm vt100-rust; do bun run --cwd \"packages/$package\" build:native; done; bash packages/ghostty-native/build/build.sh; bash packages/libvterm/build/build.sh; bun run build'"
  }
}
