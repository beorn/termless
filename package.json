{
  "name": "@termless/core",
  "version": "0.9.0",
  "description": "Headless terminal testing library — like Playwright, but for terminal apps. Cross-terminal conformance, composable selectors, 21+ Vitest matchers.",
  "keywords": [
    "ansi",
    "cross-terminal",
    "ghostty",
    "headless",
    "terminal",
    "terminal-emulator",
    "terminal-testing",
    "testing",
    "tui",
    "tui-testing",
    "vitest",
    "xterm"
  ],
  "homepage": "https://termless.dev/",
  "bugs": {
    "url": "https://github.com/beorn/termless/issues"
  },
  "license": "MIT",
  "author": "Beorn",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/termless.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist",
    "assets",
    "backends.json"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./io": "./src/io/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./io": {
        "types": "./dist/io/index.d.mts",
        "import": "./dist/io/index.mjs",
        "default": "./dist/io/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown && tsdown -W",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ci": "bun vitest run",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "fix": "oxfmt --write .",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check-private": "bun scripts/check-private-leak.ts",
    "cli": "bun packages/cli/src/cli.ts",
    "publish:all": "bun scripts/publish-workspaces.ts"
  },
  "devDependencies": {
    "@termless/alacritty": "workspace:*",
    "@termless/ghostty": "workspace:*",
    "@termless/kitty": "workspace:*",
    "@termless/libvterm": "workspace:*",
    "@termless/peekaboo": "workspace:*",
    "@termless/vt100": "workspace:*",
    "@termless/vt100-rust": "workspace:*",
    "@termless/vt220": "workspace:*",
    "@termless/vterm": "workspace:*",
    "@termless/wezterm": "workspace:*",
    "@termless/xtermjs": "workspace:*",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.14",
    "@vitest/expect": "^4.1.10",
    "@vue/server-renderer": "^3.5.39",
    "loggily": "^0.10.2",
    "oxfmt": "0.38.0",
    "silvery": "^0.4.2",
    "tsdown": "^0.22.5",
    "typescript": "^5.9.3",
    "verify-publishable": "github:beorn/verify-publishable#fd581bdf5cb4bded1a9a32e333f5fae21edd5645",
    "vitepress": "^1.6.4",
    "vitepress-enrich": "^0.4.0",
    "vitepress-plugin-llms": "^1.13.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.39"
  },
  "peerDependencies": {
    "node-pty": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "node-pty": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@twemoji/svg": "^15.0.0",
    "ghostty-web": "^0.4.0",
    "gifenc": "^1.0.3",
    "playwright": "^1.59.0",
    "upng-js": "^2.1.0"
  },
  "overrides": {
    "@termless/core": "link:."
  },
  "tsdown": {
    "clean": true,
    "dts": {
      "eager": true
    },
    "entry": [
      "src/index.ts",
      "src/io/index.ts"
    ],
    "format": "esm"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=23.6.0"
  },
  "verifyPublishable": {
    "maxUnpackedBytes": 104857600,
    "public": [
      "@termless/alacritty",
      "@termless/cli",
      "@termless/core",
      "@termless/ghostty",
      "@termless/ghostty-native",
      "@termless/kitty",
      "@termless/libvterm",
      "@termless/peekaboo",
      "@termless/swash-render",
      "@termless/test",
      "@termless/vt100",
      "@termless/vt100-rust",
      "@termless/vt220",
      "@termless/vterm",
      "@termless/web-player",
      "@termless/wezterm",
      "@termless/xtermjs",
      "termless"
    ]
  }
}
