# Golden asciicast fixtures are byte-exact oracles: keep LF on every checkout
# (PR #5, 2026-09-01: a Windows runner read them back as CRLF and every
# byte-identity assertion failed on line endings alone).
tests/asciicast/fixtures/*.cast text eol=lf

# The libvterm receipt hashes native builder output and its exact text inputs.
packages/libvterm/wasm/libvterm.js text eol=lf
packages/libvterm/wasm/libvterm.d.ts text eol=lf
packages/libvterm/build/build.sh text eol=lf
packages/libvterm/build/flat-api.c text eol=lf
packages/libvterm/src/index.ts text eol=lf
packages/libvterm/src/backend.ts text eol=lf
packages/libvterm/src/wasm-bindings.ts text eol=lf

# Preserve the private Ghostty producer's outputs and patch inputs byte-for-byte.
vendor/ghostty-web/dist/** -text
vendor/ghostty-web/*.patch -text

# Reply-delivery declarations bind the imported adapter bytes on every platform.
packages/alacritty/src/index.ts text eol=lf
packages/alacritty/src/backend.ts text eol=lf
packages/alacritty/native/src/lib.rs text eol=lf
packages/wezterm/src/index.ts text eol=lf
packages/wezterm/src/backend.ts text eol=lf
packages/wezterm/native/src/lib.rs text eol=lf
src/load-native.ts text eol=lf
packages/vt100/src/index.ts text eol=lf
packages/vt100/src/backend.ts text eol=lf
packages/vt220/src/index.ts text eol=lf
packages/vt220/src/backend.ts text eol=lf
packages/vterm/src/index.ts text eol=lf
packages/vterm/src/backend.ts text eol=lf
packages/xtermjs/src/index.ts text eol=lf
packages/xtermjs/src/backend.ts text eol=lf
