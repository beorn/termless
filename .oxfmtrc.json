{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "ignorePatterns": [
    "dist/",
    "build/",
    "out/",
    "node_modules/",
    "docs/.vitepress/dist/",
    "packages/libvterm/wasm/libvterm.js",
    "packages/libvterm/wasm/libvterm.wasm.receipt.json"
  ]
}
